# Copy this file to .env and fill in real values. .env is gitignored.

# Gemini (Google AI Studio) API key, used for extraction / entity-resolution
# assistance / conflict classification / NL query routing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# HydraDB connection (defaults match the local docker-compose setup)
HYDRA_BOLT_URI=bolt://127.0.0.1:7687
HYDRA_AUTH_TOKEN=local-development-token-32-bytes
HYDRA_DATABASE=default
